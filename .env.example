# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used for account deletion and the Stripe webhook.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (optional; AI features explain they're unavailable without it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Reverse geocoding (optional) ---
# mapbox | google | nominatim | none
GEOCODER_PROVIDER=none
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
NOMINATIM_USER_AGENT=ApprenticeOS/0.1 (contact@your-domain.example)

# --- Plans / payments (payments stay off until testing is complete) ---
BETA_ALL_PRO=false
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
